<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<RootNamespace>Luces.Mediator</RootNamespace>
		<AssemblyName>Luces.Mediator</AssemblyName>
		<!-- Trim/AOT analyzer properties only apply to modern .NET TFMs; netstandard2.0 warns on them. -->
		<IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
		<IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1951;CS1735;NU1701</NoWarn>
		<LangVersion>12</LangVersion>
		<IsPackable>true</IsPackable>
		<PackageId>Luces.Mediator</PackageId>
		<Description>A lightweight mediator library for .NET with a built-in Roslyn source generator: typed request/response and stream requests, notifications with serial or concurrent publishing (optional per-handler DI scope isolation), and pipeline behaviors. Targets netstandard2.0 and .NET 8-11.</Description>
		<PackageTags>mediator;mediator-pattern;in-process-messaging;pipeline;source-generator;notifications;cqrs</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/o0live0o/Luces.Mediator</RepositoryUrl>
		<PackageProjectUrl>https://github.com/o0live0o/Luces.Mediator</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>false</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<!-- Floor versions: every API this library uses (GetServices<T>, IServiceScopeFactory,
		     CreateScope, CreateAsyncScope) exists in Abstractions 6.0.0, which is the version
		     that introduced CreateAsyncScope. NuGet unifies upward to whatever the consumer's
		     graph already carries (CPM projects pinning 10.x are unaffected), so a low floor
		     widens compatibility without downgrading anyone. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			Version="11.0.0"
			Condition="'$(TargetFramework)' == 'netstandard2.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			Version="8.0.0"
			Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'" />
		<!-- net11.0 needs no reference: the Microsoft.NETCore.App.Ref 11.0 pack inlines
		     the abstractions assembly, so the package reference is redundant there. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			Version="10.0.13"
			Condition="'$(TargetFramework)' == 'net10.0'" />
		<ProjectReference Include="..\Luces.Mediator.SourceGen\Luces.Mediator.SourceGen.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
			GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;RuntimeIdentifier" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md"
			Pack="true"
			PackagePath="README.md" />
		<None Include="..\README.zh-cn.md"
			Pack="true"
			PackagePath="README.zh-cn.md" />
		<!-- Include (not Update): the SDK None glob does not cover buildTransitive/, so Update
		     would silently drop this file from the package and the generator would run with
		     defaults it cannot see. -->
		<None Include="buildTransitive\Luces.Mediator.props"
			Pack="true"
			PackagePath="buildTransitive\Luces.Mediator.props" />
		<None Include="..\Luces.Mediator.SourceGen\bin\$(Configuration)\netstandard2.0\Luces.Mediator.SourceGen.dll"
			Pack="true"
			PackagePath="analyzers\dotnet\cs\Luces.Mediator.SourceGen.dll"
			Visible="false" />
	</ItemGroup>

</Project>
